rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Wide-open: anyone can upload anything to any path, no auth, no size or
    // type checks. This is what makes CV / certificate uploads work regardless
    // of format and regardless of admin sign-in state.
    //
    // To tighten later, replace the block below with per-path rules such as:
    //   match /cv/{file} {
    //     allow read: if true;
    //     allow write: if request.auth != null && request.resource.size < 15 * 1024 * 1024;
    //   }
    match /{allPaths=**} {
      allow read: if true;
      allow write: if true;
    }
  }
}
