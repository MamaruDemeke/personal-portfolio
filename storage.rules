rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Project images: public read, admin-only write
    match /projects/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // CV: public read (download button), admin-only write (PDF, max 10MB)
    match /cv/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType == 'application/pdf';
    }

    // Certificate files: public read, admin-only write (PDF or image, max 10MB)
    match /certificates/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && (request.resource.contentType == 'application/pdf'
            || request.resource.contentType.matches('image/.*'));
    }

    // Profile assets (logo, favicon): public read, admin-only write (image, max 5MB)
    match /profile/{file} {
      allow read: if true;
      allow write: if request.auth != null
        && request.resource.size < 5 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }
  }
}
