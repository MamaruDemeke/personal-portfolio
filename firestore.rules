rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Projects: public read, admin-only write
    match /projects/{projectId} {
      allow read: if true;
      allow create, update, delete: if request.auth != null;
    }

    // Site content (profile, skills, experience, certificates):
    // public read, admin-only write
    match /site/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Uploaded files (CV, certificates) — stored base64 inside Firestore as the
    // free, no-card upload destination. Public read, admin-only write, with a
    // size cap that keeps every document under Firestore's 1 MiB limit.
    match /files/{fileId} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.resource.data.data is string
        && request.resource.data.data.size() <= 960000
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.type is string
        && request.resource.data.type.size() <= 100;
      allow delete: if request.auth != null;
    }

    // Messages: anyone can create (contact form), admin-only read/update/delete
    match /messages/{messageId} {
      allow create: if true
        && request.resource.data.keys().hasAll(['name', 'email', 'message', 'read', 'createdAt'])
        && request.resource.data.name is string
        && request.resource.data.name.size() <= 120
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 200
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 5000
        && request.resource.data.read == false;
      allow read, update, delete: if request.auth != null;
    }
  }
}
