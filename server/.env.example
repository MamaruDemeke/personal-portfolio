# ---- Server ----
PORT=5000
# Allowed origins for CORS, comma-separated. In dev: http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# ---- Firebase Admin ----
# Paste the FULL service-account JSON on one line (recommended), or set
# GOOGLE_APPLICATION_CREDENTIALS to a file path instead.
FIREBASE_SERVICE_ACCOUNT={"project_id":"your-project-id","private_key":"-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n","client_email":"firebase-adminsdk-xxxxx@your-project-id.iam.gserviceaccount.com"}

# ---- SMTP / Nodemailer ----
# Example for Gmail: host=smtp.gmail.com port=465 secure=true (use an App Password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=your.email@gmail.com
SMTP_PASS=your_app_password

# Where contact notifications are delivered
CONTACT_TO_EMAIL=your.email@gmail.com
